<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="@string/history_title" android:textColor="@color/navy" android:textSize="30sp" android:textStyle="bold" />
    <com.google.android.material.button.MaterialButton android:id="@+id/clearButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginTop="16dp" android:text="@string/clear_history" android:textAllCaps="false" android:textColor="@color/danger"
        app:cornerRadius="15dp" app:strokeColor="@color/danger" />
    <ProgressBar android:id="@+id/historyProgress" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="22dp" />
    <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:gravity="center" android:text="@string/history_empty" android:textColor="@color/muted"
        android:textSize="16sp" android:visibility="gone" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="16dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/historyContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
